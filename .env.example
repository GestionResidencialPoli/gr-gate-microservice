NODE_ENV=development
PORT=4300

JWT_SECRET=
# Misma clave AES-256 (32 bytes en base64url) que JWT_ENCRYPTION_KEY en gr-user-microservice:
# el access token llega cifrado (JWE dir + A256GCM) y se descifra antes de verificar la firma.
JWT_ENCRYPTION_KEY=
ACCESS_TOKEN_COOKIE_NAME=access_token

CORS_ALLOWED_ORIGINS=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=gr_gate_db
DB_POOL_MAX=10

RABBITMQ_URL=amqp://localhost:5672
GATE_EVENTS_EXCHANGE=gr.gate.events

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

COMMUNICATIONS_WS_URL=ws://localhost:4600/internal/ws
INTERNAL_SERVICE_TOKEN=
COMMUNICATIONS_TIMEOUT_MS=3000
COMMUNICATIONS_SILENCE_LIMIT_MS=60000

HORAS_POSIBLE_OLVIDO=12
TIMEZONE_OFFSET=-05:00
